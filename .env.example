# Revenue Pulse - environment template.
# Copy to .env and fill in. .env is gitignored; never commit real values.
#   cp .env.example .env
#
# RP_SVC authenticates with an RSA key pair only - there is no password
# variable here, and TYPE = SERVICE users cannot have one.

# Account identifier in <orgname>-<account_name> form, not the full URL.
# Snowsight -> account selector (bottom left) -> account "..." -> Copy account identifier
SNOWFLAKE_ACCOUNT=myorg-myaccount

# Service user created by setup/00_setup.sql.
SNOWFLAKE_USER=RP_SVC

# PKCS#8 private key, kept OUTSIDE this repository. Leading ~ is expanded by
# the loader (scripts/check_connection.py), not by dotenv itself.
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8

# Optional: the passphrase the key was encrypted with. Leave empty for a key
# generated with openssl pkcs8 -nocrypt.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Session defaults.
SNOWFLAKE_ROLE=RP_ROLE
SNOWFLAKE_WAREHOUSE=RP_WH
SNOWFLAKE_DATABASE=REVENUE_PULSE
SNOWFLAKE_SCHEMA=STAGING

# Weekly AI summary. scripts/generate_summary.py calls the Anthropic API,
# because Cortex AI_COMPLETE is unavailable on a trial account
# (DECISIONS.md part 10). Required for --backend anthropic, which is the
# default; --backend template needs no key.
ANTHROPIC_API_KEY=sk-ant-...

# Backend selector: anthropic (default) | cortex | template
SUMMARY_BACKEND=anthropic

# Model used by the cortex backend, for a non-trial account.
CORTEX_MODEL=claude-4-sonnet

# Synthetic data generation. Keep at 42 so runs are reproducible.
SEED=42
